# KIT (ConvertKit) API Configuration
# Copy this file to .env and fill in your actual values

# Get your API key from: https://app.convertkit.com/account_settings/advanced_settings
KIT_API_KEY=your_kit_api_key_here

# Get your Form ID from your form settings (numeric ID)
KIT_FORM_ID=your_form_id_here

# Optional: Custom base URL (usually not needed)
KIT_API_BASE_URL=https://api.convertkit.com/v3

# Development settings
NODE_ENV=development
PORT=3001